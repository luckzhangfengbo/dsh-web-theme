{
  "name": "dsh-web-theme",
  "version": "0.1.0",
  "description": "墨韵 · 中国水墨画风格主题 · DeepSeek Harness 插件",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "client",
    "src",
    "themes",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-theme",
    "水墨",
    "中国风",
    "skin",
    "wallpaper",
    "ink-painting",
    "chinese",
    "i18n",
    "multi-language"
  ],
  "author": "橙虚得猿",
  "license": "MIT",
  "homepage": "https://github.com/RevolutionLA/dsh-web-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RevolutionLA/dsh-web-theme.git"
  },
  "bugs": {
    "url": "https://github.com/RevolutionLA/dsh-web-theme/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.4.0"
  }
}